{
  "name": "memcue-dsh",
  "version": "0.2.1",
  "description": "memcue long-term memory for DeepSeek Harness (dsh): facts recalled before a step, extracted when a turn ends",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.mjs",
  "exports": "./src/index.mjs",
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juev/memcue.git",
    "directory": "plugins/deepseek-harness"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
