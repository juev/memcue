{
  "name": "memcue-pi",
  "version": "0.36.2",
  "description": "memcue long-term memory for the Pi coding agent: native tools, repository pitfalls and opt-in subagent memory",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juev/memcue.git",
    "directory": "plugins/pi"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "children",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "^24.13.3",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  }
}
