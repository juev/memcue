{
  "name": "memcue-opencode",
  "version": "0.40.2",
  "description": "memcue long-term memory for OpenCode: native tools, repository pitfalls and opt-in subagent memory",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode-plugin",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juev/memcue.git",
    "directory": "plugins/opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "^2.0.13",
    "memcue-transport": "^0.40.1"
  },
  "peerDependencies": {
    "@opencode/theme": ">=2.2.7",
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "2.2.7",
    "@opentui/core": "0.8.1",
    "@opentui/solid": "0.8.1",
    "@types/node": "^24.13.3",
    "solid-js": "1.9.17",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tui.json"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
